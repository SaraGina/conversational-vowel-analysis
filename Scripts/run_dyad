#!/bin/bash
# One dyad, one command:  ./run_dyad my_dyad.yaml
# Uses the project venv (create it once: python3 -m venv venv && ./venv/bin/pip install -r requirements_asr.txt)
HERE="$(cd "$(dirname "$0")" && pwd)"
PY="$HERE/venv/bin/python"
[ -x "$PY" ] || { echo "venv not found - run the Install step in the README first"; exit 1; }
cd "$HERE" && exec "$PY" -m pipeline.run "$@"
